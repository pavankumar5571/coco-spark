
out/clips/

out/episode.mp4
out/concat.txt
__pycache__/

# generated media — regenerable, bloats the repo every render
out/*/clips/*
out/*/frames/*
out/*/transitions/*
out/location_plates/*/*.png
out/*/probe/*
out/*/postfx/*
out/*/qcframes/*
out/*/baseline/*
out/*/episode.mp4
out/*/concat.txt

# ...but NOT the evidence. Provenance says what we paid for and QC says what it taught
# us; neither is regenerable, because regenerating it costs money and the provider is
# stochastic. Losing these is how the previous project ended up unable to say what it had
# already learned.
!out/*/clips/*.provenance.json
!out/*/clips/*.qc.json
!out/*/frames/*.provenance.json
!out/*/baseline/*.provenance.json
!out/*/baseline/*.qc.json
!out/location_plates/*/*.provenance.json
!out/location_plates/*/*.qc.json

# SECRETS. This repository is PUBLIC. A key that reaches a commit here is world-readable
# within seconds, and rotating it afterwards does not un-publish it.
.env
.env.*
*.env
env
credentials/
*client_secret*
*refresh_token*
token.json
.channel-seen.json
.channel-watch-*.lock
